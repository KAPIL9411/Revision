# ---------------------------------------------------------------------------
# Supabase (optional). Leave these blank to run the vault entirely on-device.
# Copy this file to .env.local and fill in your project values.
# The anon key is public by design — never put a service-role key in the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only this Google account may open the vault. Leave blank to allow any
# signed-in account (RLS still isolates every account's rows).
NEXT_PUBLIC_ALLOWED_EMAIL=

# Storage bucket created by supabase/migrations/0001_init.sql
NEXT_PUBLIC_SUPABASE_BUCKET=attachments

# ---------------------------------------------------------------------------
# Google Drive (optional, recommended). Photos — question screenshots and
# handwritten solutions — upload to a folder called "SSC Revision Vault" in
# your own Drive. Create an OAuth *Web application* client in Google Cloud
# Console, enable the Google Drive API, and authorise your origins
# (http://localhost:3000 and your deployed URL). Only the public client ID is
# needed at runtime; there is no client secret in the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
